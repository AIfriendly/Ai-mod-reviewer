# Copy to .env and fill in. .env is git-ignored.

# --- Script generation (required) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- NexusMods research + media (required for the research/asset stages) ---
# Get a personal key at https://www.nexusmods.com/users/myaccount?tab=api
NEXUS_API_KEY=

# --- Text-to-speech (pick the provider you configured in config/voice.yaml) ---
# ElevenLabs cloned voice:
ELEVENLABS_API_KEY=
# The voice ID of YOUR cloned voice (created in the ElevenLabs dashboard):
ELEVENLABS_VOICE_ID=

# OpenAI TTS (only if you use the openai provider):
OPENAI_API_KEY=

# Kaggle FREE GPU for the F5 cloned voice (provider/--voice kaggle).
# Kaggle -> Settings -> API -> Create New Token (downloads kaggle.json).
# Phone-verify your Kaggle account to enable GPU + internet on kernels.
KAGGLE_USERNAME=
KAGGLE_KEY=
